PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/agrihar_blog
MONGO_URI_ATLAS=

# Super Admin — used as a fallback login before any DB admin is created.
# Once you create a SuperAdmin via the DB, these env vars are no longer needed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Legacy admin login (kept for backward compatibility)
ADMIN_USERNAME=admin

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Local dev: CORS_ORIGIN=*
# Production: set to your Vercel frontend URL (comma-separated for multiple)
CORS_ORIGIN=https://agrihar-blog-frontend.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
